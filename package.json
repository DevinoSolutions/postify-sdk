{
  "name": "@postify/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Postify public API (https://app.usepostify.com/v1) — posts, channels, media, analytics, usage, webhook endpoints, and Standard-Webhooks signature verification.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/postify-sdk.git"
  },
  "homepage": "https://usepostify.com/developers",
  "keywords": [
    "postify",
    "social-media",
    "scheduling",
    "api",
    "sdk",
    "webhooks",
    "standard-webhooks"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@postify/contracts": "workspace:*",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.1"
  }
}
